{
	"name": "obsidian-broken-heading-links",
	"version": "1.0.0",
	"description": "Obsidian plugin that finds and fixes links to headings and blocks that no longer exist.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import tsx --test tests/*.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"plugin",
		"paste",
		"ai",
		"chatgpt",
		"claude",
		"markdown"
	],
	"author": "Brian Zucker",
	"license": "0BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.14.0",
		"obsidian": "1.14.4",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.1"
	}
}
